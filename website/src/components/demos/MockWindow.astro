---
interface Props {
  title?: string;
  variant?: 'plain' | 'editor' | 'browser' | 'terminal' | 'notes';
  class?: string;
}

const { title = '', variant = 'plain', class: className } = Astro.props;
---

<div class:list={['mock-win', `v-${variant}`, className]}>
  <div class="win-bar">
    <span class="tl tl-r" /><span class="tl tl-y" /><span class="tl tl-g" />
    {title && <span class="win-title">{title}</span>}
  </div>
  <div class="win-body">
    {
      variant === 'terminal' ? (
        <slot>
          <span class="prompt">❯</span>
        </slot>
      ) : (
        <>
          <span class="sk sk-a" />
          <span class="sk sk-b" />
          <span class="sk sk-c" />
          <slot />
        </>
      )
    }
  </div>
</div>

<style>
  .mock-win {
    position: absolute;
    display: flex;
    flex-direction: column;
    background: var(--demo-win-bg);
    border: 1px solid var(--demo-win-border);
    border-radius: var(--r-win);
    box-shadow: var(--shadow-win);
    overflow: hidden;
  }

  .mock-win:global(.is-focused) {
    box-shadow:
      0 0 0 2.5px var(--demo-accent),
      0 0 14px var(--demo-accent-glow),
      var(--shadow-win);
  }

  .win-bar {
    display: flex;
    align-items: center;
    gap: 4%;
    flex: 0 0 auto;
    height: clamp(12px, 14%, 22px);
    max-height: 22px;
    padding: 0 5%;
    background: var(--demo-win-bar);
  }

  .tl {
    width: clamp(4px, 6%, 8px);
    aspect-ratio: 1;
    border-radius: 50%;
    flex: 0 0 auto;
  }

  .tl-r {
    background: var(--demo-traffic-r);
  }

  .tl-y {
    background: var(--demo-traffic-y);
  }

  .tl-g {
    background: var(--demo-traffic-g);
  }

  .win-title {
    font-size: clamp(5px, 1.4cqw, 10px);
    color: rgba(255, 255, 255, 0.55);
    white-space: nowrap;
    overflow: hidden;
  }

  .win-body {
    position: relative;
    flex: 1;
    padding: 8% 7%;
    display: flex;
    flex-direction: column;
    gap: 9%;
  }

  .sk {
    display: block;
    height: 7%;
    min-height: 3px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.13);
  }

  .sk-a {
    width: 72%;
    background: rgba(255, 255, 255, 0.22);
  }

  .sk-b {
    width: 88%;
  }

  .sk-c {
    width: 55%;
  }

  .v-notes .sk-a {
    background: rgba(255, 214, 130, 0.45);
  }

  .v-browser .sk-a {
    background: rgba(102, 153, 255, 0.45);
  }

  .v-terminal {
    background: var(--demo-term-bg);
  }

  .v-terminal .win-body {
    font-family: var(--font-mono);
    font-size: clamp(6px, 1.7cqw, 11px);
    color: var(--demo-term-fg);
    gap: 6%;
  }

  .prompt {
    color: var(--demo-term-green);
  }
</style>
