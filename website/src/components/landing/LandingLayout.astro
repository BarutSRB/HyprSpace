---
import '../../styles/demo-tokens.css';
import '../../styles/landing.css';
import logoSvg from '../../assets/brand/omniwm-logo.svg';
import markSvg from '../../assets/brand/omniwm-mark.svg';
import { version } from '../../data/site';

interface Props {
  title: string;
  description: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, structuredData } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const applicationSchema = {
  '@type': 'SoftwareApplication',
  '@id': 'https://omniwm.app/#software',
  name: 'OmniWM',
  url: 'https://omniwm.app/',
  image: 'https://omniwm.app/og.png',
  description,
  operatingSystem: 'macOS 26 or later',
  applicationCategory: 'UtilitiesApplication',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://spdx.org/licenses/GPL-2.0-only.html',
  softwareVersion: version,
  downloadUrl: 'https://github.com/BarutSRB/OmniWM/releases/latest',
  author: { '@type': 'Person', name: 'BarutSRB', url: 'https://github.com/BarutSRB' },
  sameAs: ['https://github.com/BarutSRB/OmniWM'],
};
const additionalSchemas = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [applicationSchema, ...additionalSchemas] });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OmniWM" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://omniwm.app/og.png" />
    <meta property="og:image:alt" content="OmniWM — a tiling window manager for macOS" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#763424" />
    <meta name="theme-color" content="#F8F4EC" />
    <script is:inline>
      (() => {
        let stored;
        try {
          stored = localStorage.getItem('starlight-theme');
        } catch {}
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <img class="logo wide-only" src={logoSvg.src} alt="OmniWM" width="190" height="61" />
          <img class="logo narrow-only" src={markSvg.src} alt="OmniWM" width="40" height="40" />
        </a>
        <nav class="nav">
          <a href="#features">Features</a>
          <a href="#install">Install</a>
          <a href="/guides/quick-start/">Docs</a>
          <a href="https://github.com/BarutSRB/OmniWM">GitHub</a>
          <button class="theme-toggle" type="button" aria-label="Toggle color theme">
            <span class="tt-sun">☀</span><span class="tt-moon">☾</span>
          </button>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--page-bg) 82%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--page-frame-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
  }

  .logo {
    height: 44px;
    width: auto;
  }

  .logo.narrow-only {
    height: 36px;
    display: none;
  }

  :root[data-theme='dark'] .logo {
    filter: brightness(0) invert(1) sepia(0.06) saturate(0.8);
  }

  @media (max-width: 560px) {
    .logo.wide-only {
      display: none;
    }

    .logo.narrow-only {
      display: block;
    }
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 14.5px;
    font-weight: 500;
  }

  .nav a {
    color: var(--page-fg);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--page-accent);
  }

  @media (max-width: 560px) {
    .nav a:not(:last-of-type) {
      display: none;
    }
  }

  .theme-toggle {
    border: 1px solid var(--page-frame-border);
    background: var(--page-surface);
    color: var(--page-fg);
    border-radius: 8px;
    width: 34px;
    height: 34px;
    cursor: pointer;
    font-size: 15px;
    line-height: 1;
  }

  .tt-moon {
    display: none;
  }

  :root[data-theme='dark'] .theme-toggle .tt-sun {
    display: none;
  }

  :root[data-theme='dark'] .theme-toggle .tt-moon {
    display: inline;
  }
</style>

<script>
  const toggle = document.querySelector('.theme-toggle');
  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('starlight-theme', next);
    } catch {}
  });
</script>
